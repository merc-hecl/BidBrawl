{
  "schema_version": 1,
  "default_deck": ["largest_price", "random_shape", "item_count", "quality_counts", "value_band"],
  "cards": [
    {
      "id": "largest_quality",
      "name": "巨物鉴定",
      "description": "揭示面积最大物品的品质；并列按物品 ID 排序取首个。",
      "effect": {"type": "reveal", "selector": "largest", "fields": ["quality"]}
    },
    {
      "id": "largest_price",
      "name": "巨物估价",
      "description": "揭示面积最大物品的真实价格。",
      "effect": {"type": "reveal", "selector": "largest", "fields": ["price"]}
    },
    {
      "id": "random_shape",
      "name": "轮廓扫描",
      "description": "揭示一件随机物品的 ID 和两个角坐标。",
      "effect": {"type": "reveal", "selector": "random", "fields": ["shape"]}
    },
    {
      "id": "random_quality",
      "name": "随机鉴定",
      "description": "揭示一件随机物品的 ID 和品质。",
      "effect": {"type": "reveal", "selector": "random", "fields": ["quality"]}
    },
    {
      "id": "item_count",
      "name": "清点",
      "description": "揭示物品总数。",
      "effect": {"type": "count"}
    },
    {
      "id": "quality_counts",
      "name": "品质普查",
      "description": "揭示每种品质的物品数量。",
      "effect": {"type": "count", "group_by": "quality"}
    },
    {
      "id": "value_band",
      "name": "区间估值",
      "description": "揭示总价值所在的 1000 金币区间 [下界, 上界)。",
      "effect": {"type": "value_band", "band_size": 1000}
    }
  ]
}
